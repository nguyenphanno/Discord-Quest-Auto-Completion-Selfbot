# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Raw user token (never commit a real one, never prefix it with "Bot ").
TOKEN=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# Discord webhook used for completion reports and the run summary.
WEBHOOK_URL=

# Third-party hCaptcha solver. Discord's hCaptcha integration is unreliable with
# hosted solvers (error 10008), so automatic solving is off by default.
YES_CAPTCHA_API_KEY=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Claim rewards for quests that are already completed (default: false).
REDEEM_REWARDS=

# Max concurrent quest workers. Empty or 0 keeps the unbounded fan-out.
QUEST_CONCURRENCY=

# Also resolve the config of quests the account cannot participate in.
FETCH_EXCLUDED_QUESTS=

# Process only these quest ids / skip these quest ids (space or comma separated).
QUEST_INCLUDE=
QUEST_EXCLUDE=

# Pin the client build number instead of scraping discord.com/app.
CLIENT_BUILD_NUMBER=

# ---------------------------------------------------------------------------
# Request fingerprint
# ---------------------------------------------------------------------------
DISCORD_TIMEZONE=Asia/Saigon
DISCORD_LOCALE=en-US
DISCORD_ACCEPT_LANGUAGE=vi

# ---------------------------------------------------------------------------
# Console UI
# ---------------------------------------------------------------------------
# trace | debug | info | success | warn | error | fatal | silent
LOG_LEVEL=info
# Newline-delimited JSON records, useful for log collectors.
LOG_JSON=
# ASCII-only glyphs for legacy consoles.
LOG_ASCII=
# Force colour on/off. Empty means automatic (NO_COLOR is honoured).
LOG_COLOR=
LOG_TIMESTAMPS=

# ---------------------------------------------------------------------------
# HTTP tuning for non-REST calls
# ---------------------------------------------------------------------------
HTTP_TIMEOUT_MS=
HTTP_RETRIES=
HTTP_RETRY_DELAY_MS=
